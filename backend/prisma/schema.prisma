generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "darwin-arm64", "windows", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(cuid())
  fullName    String
  phoneNumber String   @unique
  username    String   @unique
  password    String
  role        UserRole @default(STUDENT)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  testSessions          TestSession[]
  results               Result[]
  activeSessions        ActiveSession[]
  passwordResetRequests PasswordResetRequest[]

  @@index([role])
  @@index([username])
}

enum UserRole {
  ADMIN
  STUDENT
}

model TestSession {
  id            String   @id @default(cuid())
  pinCode       String   @unique
  title         String
  maxAttempts   Int      @default(1)
  createdBy     String
  createdByUser User     @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sections       TestSection[]
  results        Result[]
  activeSessions ActiveSession[]

  @@index([pinCode])
  @@index([isActive])
}

model TestSection {
  id                  String               @id @default(cuid())
  testSessionId       String
  testSession         TestSession          @relation(fields: [testSessionId], references: [id], onDelete: Cascade)
  subject             SectionSubject
  sectionType         SectionType          @default(EXERCISE)
  selectionMode       SectionSelectionMode @default(BY_EXERCISE)
  targetQuestionCount Int?
  variantGroups       String // JSON array: '["1_5","10_15"]'
  numberOfExercises   Int
  timeAllocated       Int // minutes for entire section
  sectionOrder        Int
  createdAt           DateTime             @default(now())

  @@unique([testSessionId, sectionOrder])
  @@index([testSessionId])
}

enum SectionSubject {
  VOCABULARY
  GRAMMAR
}

enum SectionType {
  EXERCISE
  PRACTICE_TEST
}

enum SectionSelectionMode {
  BY_EXERCISE
  BY_QUESTION
}

model Result {
  id            String      @id @default(cuid())
  studentId     String
  student       User        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  testSessionId String
  testSession   TestSession @relation(fields: [testSessionId], references: [id], onDelete: Cascade)

  attemptNumber  Int    @default(1)
  totalScore     Float
  vocabScore     Float?
  grammarScore   Float?
  vocabCorrect   Int?
  vocabTotal     Int?
  grammarCorrect Int?
  grammarTotal   Int?

  submittedAt DateTime @default(now())
  isCompleted Boolean  @default(true)

  answers StudentAnswer[]

  @@index([studentId])
  @@index([testSessionId])
  @@index([studentId, testSessionId])
}

model StudentAnswer {
  id             String         @id @default(cuid())
  resultId       String
  result         Result         @relation(fields: [resultId], references: [id], onDelete: Cascade)
  questionId     String
  questionType   SectionSubject
  exerciseId     String?
  questionText   String
  selectedAnswer String
  correctAnswer  String
  isCorrect      Boolean
  createdAt      DateTime       @default(now())

  @@index([resultId])
}

model ActiveSession {
  id            String      @id @default(cuid())
  studentId     String
  student       User        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  testSessionId String
  testSession   TestSession @relation(fields: [testSessionId], references: [id], onDelete: Cascade)
  pinCode       String

  currentSubject  SectionSubject
  sectionOrder    Int            @default(1)
  sectionDeadline DateTime

  // JSON: selected exercise IDs per section order: {"1": ["grammar_1_5_001", ...], "2": [...]}
  selectedExercises String @default("{}")
  // JSON: specific sliced question IDs allowed for grading: {"1": ["grammar_1_5_001_q1", ...]}
  selectedQuestions String @default("{}")
  answers           String @default("[]") // JSON: array of SubmitAnswer

  tabSwitchCount Int      @default(0)
  lastActive     DateTime @default(now())
  isActive       Boolean  @default(true)

  createdAt DateTime @default(now())

  @@index([studentId])
  @@index([testSessionId])
  @@index([pinCode])
}

model PasswordResetRequest {
  id        String   @id @default(cuid())
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String
  resetCode String
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([studentId])
  @@index([resetCode])
}
